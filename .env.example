# Copy this file to .env to change the defaults.

# Port the app listens on.
PORT=3080

# Behind nginx at /demerits/: only nginx can reach the app, and the login cookie stays out of
# the other project on the same server. See "Run it behind nginx" in the README.
# HOST=127.0.0.1
# COOKIE_PATH=/demerits/
# Also set this if nginx serves the site over HTTPS.
# SECURE_COOKIES=1

# Where the database, backups and first-login passwords are kept.
# DATA_DIR=data

# Recommended: a certificate file turns on HTTPS, so passwords cannot be read off the Wi-Fi.
# HTTPS_PFX=certs\prefects.pfx
# HTTPS_PFX_PASSPHRASE=
